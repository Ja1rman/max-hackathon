# Copy to .env for MAX setup. Never commit live secrets.
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/banquet.sqlite
# Docker Compose listens on 3100; direct Node development uses its default 3000.
PUBLIC_URL=http://localhost:3100
VITE_BASE_PATH=/
TRUST_PROXY=false
DEMO_ENABLED=true
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=
RESTAURANT_ADMIN_IDS=
# true — любой пользователь MAX становится организатором во всех ресторанах; иначе доступы выдаёт администратор
OPEN_ORGANIZER_SIGNUP=false
